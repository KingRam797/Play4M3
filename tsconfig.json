{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "packages/loading-screen/src/engine.ts",
    "packages/loading-screen/src/index.ts",
    "apps/desktop/src/renderer/**",
    "apps/web/src/**"
  ]
}
